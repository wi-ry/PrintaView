{
  "name": "printaview",
  "version": "1.5.2",
  "description": "Unified Downloads preview app for Windows",
  "main": "src/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "screenshots": "node scripts/capture-screenshots.js",
    "test": "npm run test:unit",
    "test:unit": "node --test test/*.test.js",
    "test:e2e": "playwright test",
    "test:packaged": "playwright test --config=playwright.packaged.config.js",
    "test:all": "npm run test:unit && npm run test:e2e",
    "build:win": "electron-builder --win portable --publish never",
    "build:win:ci": "electron-builder --win portable --publish never --config.compression=normal",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "playwright": "^1.61.1"
  },
  "build": {
    "appId": "com.printaview.app",
    "productName": "PrintaView",
    "compression": "maximum",
    "asar": true,
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.md",
      "!**/test/**",
      "!**/tests/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "assets/icon.ico",
      "signExecutable": false,
      "target": [
        "portable"
      ],
      "artifactName": "${productName}-${version}-Portable.${ext}"
    }
  },
  "dependencies": {
    "pdfjs-dist": "^6.5.438",
    "sharp": "^0.35.5"
  }
}
